# Copy this file to .env, then fill in your values. .env is never committed (see .gitignore).
#   cp .env.example .env

# Your key, from https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Your Last.fm user name
LASTFM_USER=

# Seconds during which the server reuses Last.fm's answer
RECENT_TTL=120

# Set to 1 to show fake data, without calling Last.fm
DEMO=
